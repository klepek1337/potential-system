# Comma-separated OKX instrument IDs. Perpetual futures use the -SWAP suffix.
OKX_INSTRUMENT_IDS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP

# Scanner behavior
POLL_INTERVAL_SECONDS=30
DISPLAY_TIMEZONE=Europe/Luxembourg
STATE_DATABASE_PATH=data/ma_alerts.sqlite3
POSITIONS_FILE_PATH=data/positions.json
MOVING_AVERAGE_TOUCH_MARGIN_PERCENT=0.1
SEND_STARTUP_SUMMARY=true
# Keep both false to receive only the short version/update message.
SEND_STARTUP_CONFIGURATION=false
SEND_STARTUP_LEVEL_SUMMARIES=false
EMA_PERIODS=20,50,120,200
DOMINANT_EMA_TIMEFRAMES=15m,1H,4H,1D
DOMINANT_EMA_SCAN_INTERVAL_SECONDS=3600
MINUTE_SMA_TILT_ENABLED=true
MINUTE_SMA_TILT_PERIOD=200
MINUTE_SMA_TILT_LOOKBACK_MINUTES=5
MINUTE_SMA_TILT_STRONG_THRESHOLD_ATR=0.25
MINUTE_SMA_TILT_CHANGE_THRESHOLD_ATR=0.5
MINUTE_SMA_TILT_COOLDOWN_SECONDS=600

# Accept /szpont BTCUSDT from TELEGRAM_CHAT_ID.
TELEGRAM_COMMANDS_ENABLED=true
SZPONT_MINIMUM_NORMALIZED_HISTOGRAM_SLOPE=0.001

# Keep true until the console output looks correct.
DRY_RUN=true

# Required only when DRY_RUN=false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
