# Comma-separated OKX instrument IDs. Perpetual futures use the -SWAP suffix.
OKX_INSTRUMENT_IDS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP

# Scanner behavior
POLL_INTERVAL_SECONDS=30
DISPLAY_TIMEZONE=Europe/Luxembourg
STATE_DATABASE_PATH=data/ma_alerts.sqlite3
MOVING_AVERAGE_TOUCH_MARGIN_PERCENT=0.1
SEND_STARTUP_SUMMARY=true
SEND_DECISION_REPORTS=true
DAILY_DECISION_REPORT_LOCAL_TIME=08:00

# Position reporting: manual, okx_read_only, or okx_with_manual_override.
POSITION_SOURCE=manual
POSITION_PLANS_PATH=position_plans.json

# Required only for an OKX position source. Create a read-only API key.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Optional AI research. OpenAI is never given an OKX API key and cannot trade.
AI_ANALYSIS_ENABLED=false
AI_EVENT_REPORTS_ENABLED=true
AI_DAILY_REPORT_LOCAL_TIME=08:05
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=high

# Deterministic position-risk warnings, independent from AI.
STOP_WARNING_DISTANCE_PERCENT=1.0
LIQUIDATION_WARNING_DISTANCE_PERCENT=5.0

# Keep true until the console output looks correct.
DRY_RUN=true

# Required only when DRY_RUN=false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
